# Public web configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GTM 컨테이너 ID. 미설정 시 apps/web/src/components/google-tag-manager.tsx의 기본값을 사용.
NEXT_PUBLIC_GTM_ID=GTM-WP6FQ3HK

# Server-only Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Collector credentials (optional in fixture mode)
GITHUB_TOKEN=
GITHUB_SEARCH_QUERY=topic:artificial-intelligence pushed:>=2026-07-01
HN_SEARCH_QUERY=AI agent
# Product Hunt GraphQL v2 developer token(무료·무기한). 없으면 라이브 수집을 blocked 처리. 발급법은 docs/external-services-setup.md 참고.
PRODUCT_HUNT_TOKEN=
# Reddit OAuth(script app) client credentials. 없으면 라이브 수집을 blocked 처리. 발급법은 docs/external-services-setup.md 참고.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
THREADS_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# Analysis and delivery providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# 트렌드 분석 프로바이더로 Groq를 쓰려면(관리자가 /admin/settings에서 선택) 이 키도 필요하다.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# 실행당 최대 순차 분석 건수(0~100). 무료 할당량 한도 도달 시 자동 중단.
GEMINI_ANALYSIS_LIMIT=50
AUTO_APPROVE_ANALYZED=true
# 이메일 발송: Gmail API(OAuth2) 우선, 없으면 Resend. 둘 다 없으면 발송 blocked.
# Gmail API: Google Cloud OAuth 클라이언트 + gmail.send 권한 refresh token. EMAIL_FROM은 인증한 Gmail 계정이어야 함.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=오늘의 AI <noreply@example.com>

# Runtime behavior
APP_TIMEZONE=Asia/Seoul
COLLECTOR_MODE=fixture
SCORING_VERSION=v1
