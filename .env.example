# Public web configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Collector credentials (optional in fixture mode)
GITHUB_TOKEN=
GITHUB_SEARCH_QUERY=topic:artificial-intelligence pushed:>=2026-07-01
HN_SEARCH_QUERY=AI agent
PRODUCT_HUNT_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
THREADS_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# Analysis and delivery providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# 실행당 최대 순차 분석 건수(0~100). 무료 할당량 한도 도달 시 자동 중단.
GEMINI_ANALYSIS_LIMIT=50
AUTO_APPROVE_ANALYZED=true
RESEND_API_KEY=
EMAIL_FROM=AI Trend Radar <radar@example.com>

# Runtime behavior
APP_TIMEZONE=Asia/Seoul
COLLECTOR_MODE=fixture
SCORING_VERSION=v1
